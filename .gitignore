# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# uv virtual environment (every teammate makes their own with `uv sync`)
.venv/

# Secrets: never commit these. Keep API keys and passwords in .env
.env
.env.*
!.env.example

# Operating system and editor clutter
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# SolarScope: never commit the answer key or run outputs. The repo is PUBLIC.
SolarScope_MVP1_AnswerKey_INTERNAL/
answer_key/
output/
# input/: only the supplied synthetic dataset (input/mvp1) is committed; drop other datasets here locally
input/*
!input/.gitkeep
!input/mvp1/
.pytest_cache/
.ruff_cache/
